# Шаблон змінних середовища
# Копіюйте це в файл .env та заповніть відповідні значення

# РЕЖИМ РОБОТИ
FLASK_ENV=development
FLASK_DEBUG=True

# БЕЗПЕКА
SECRET_KEY=your-super-secret-key-change-this-in-production

# БАЗА ДАНИХ
# SQLite (за замовчуванням)
DATABASE_URL=sqlite:///users.db

# PostgreSQL (для production)
# DATABASE_URL=postgresql://user:password@localhost:5432/myapp

# СЕРВЕР
HOST=0.0.0.0
PORT=8000

# CORS (Дозволені джерела)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001,https://alexsite-swzo.onrender.com

# AI ІНТЕГРАЦІЯ
# URL до AI сервісу (FastAPI)
AI_API_URL=http://localhost:8001/api/chat

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_EXPIRATION_HOURS=720

# LOGS
LOG_LEVEL=INFO

